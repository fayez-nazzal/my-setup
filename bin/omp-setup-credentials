#!/bin/zsh -f
# One-time macOS recovery; normal omp launches never sign into a personal account.
unsetopt xtrace verbose
setopt errexit nounset pipefail

if [[ ${1:-} == --help ]]; then
  print 'Usage: zsh bin/omp-setup-credentials'
  print 'Interactively sign into 1Password, create an OMP-vault read-only service account,'
  print 'verify its five credential references, and replace the macOS Keychain token.'
  print 'Secrets stay in memory and Keychain, never argv, files, or terminal output.'
  exit 0
fi
[[ $# == 0 ]] || { print -u2 'Unexpected argument; use --help.'; exit 2; }
[[ $(uname -s) == Darwin ]] || { print -u2 'This recovery command requires macOS Keychain; see zsh/README.md for Linux.'; exit 1; }
[[ -t 0 && -t 1 ]] || { print -u2 'Run this command in your terminal: 1Password sign-in needs interactive input.'; exit 1; }
command -v op >/dev/null || { print -u2 'Install the 1Password CLI first.'; exit 1; }
for name in ${(k)parameters}; do
  [[ $name == OP_* ]] && unset "$name"
done

account="$(id -un)"
service=my-setup.omp.service-account
stamp="$(date +%Y%m%d%H%M%S)-$$"
candidate="$service.candidate-$stamp"
backup="$service.backup-$stamp"

# security -i consumes the secret on stdin, not as a process argument.
# Its process status alone does not report all interactive command failures.
store_secret() {
  local target="$1" value="$2" result escaped_account
  escaped_account="${account//\\/\\\\}"
  escaped_account="${escaped_account//\"/\\\"}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  result="$(printf 'add-generic-password -a "%s" -s "%s" -T "" -w "%s"\n' "$escaped_account" "$target" "$value" | /usr/bin/security -i 2>&1)" || return 1
  [[ -z $result ]] && /usr/bin/security find-generic-password -a "$account" -s "$target" >/dev/null 2>&1
}

print 'Sign into your personal 1Password account for this one-time repair.'
# Capture the trusted CLI's shell exports; never print its session token.
signin_exports="$(op signin)"
eval "$signin_exports"
unset signin_exports
token="$(op service-account create "OMP runtime $stamp" --vault OMP:read_items --raw)"
[[ -n $token ]] || { print -u2 '1Password returned an empty token; Keychain is unchanged.'; exit 1; }
store_secret "$candidate" "$token" || { print -u2 'Could not save the new token in Keychain. The original item is unchanged.'; exit 1; }
print "New token saved securely as $candidate."

# Verify the scoped account, not the personal account used to create it.
for name in ${(k)parameters}; do
  [[ $name == OP_* ]] && unset "$name"
done
export OP_SERVICE_ACCOUNT_TOKEN="$token"
op whoami >/dev/null
for ref in \
  'op://OMP/OMP ANTHROPIC/password' \
  'op://OMP/OMP OPENAI/password' \
  'op://OMP/OpenRouter API Key - omp/credential' \
  'op://OMP/OMP EXCALIDRAW/password' \
  'op://OMP/Perplexity Web Search/password'; do
  value="$(op read "$ref" --no-newline)"
  [[ -n $value ]] || { print -u2 "Empty credential: $ref. Original token unchanged; new token remains in $candidate."; exit 1; }
  print "Verified $ref"
done
unset value

if /usr/bin/security find-generic-password -a "$account" -s "$service" >/dev/null 2>&1; then
  old="$(/usr/bin/security find-generic-password -a "$account" -s "$service" -w)"
  store_secret "$backup" "$old" || { print -u2 'Could not back up the old Keychain item; it was not replaced.'; exit 1; }
  unset old
  # Updating with -U does not remove trusted applications. Recreate the item.
  /usr/bin/security delete-generic-password -a "$account" -s "$service" >/dev/null
  print "Previous token backed up in Keychain as $backup."
fi
if ! store_secret "$service" "$token"; then
  print -u2 "Could not install the token. It remains safe in Keychain as $candidate; any previous token is in $backup."
  exit 1
fi
unset token OP_SERVICE_ACCOUNT_TOKEN
/usr/bin/security delete-generic-password -a "$account" -s "$candidate" >/dev/null
print 'OMP token replaced with no trusted applications. Start omp; choose Allow, not Always Allow.'
print 'Revoke the obsolete service account in 1Password after checking the new session.'
