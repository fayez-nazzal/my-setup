#!/usr/bin/env bash
set -euo pipefail

resolve_path() {
  local path="$1" dir target
  while [ -L "$path" ]; do
    dir="$(cd -P "$(dirname "$path")" >/dev/null 2>&1 && pwd)"
    target="$(readlink "$path")"
    case "$target" in /*) path="$target" ;; *) path="$dir/$target" ;; esac
  done
  dir="$(cd -P "$(dirname "$path")" >/dev/null 2>&1 && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}
self="$(resolve_path "$0")"
real=""
old_ifs="$IFS"; IFS=:
for dir in $PATH; do
  [ -n "$dir" ] || dir=.
  candidate="$dir/alacritty"
  [ -x "$candidate" ] || continue
  resolved="$(resolve_path "$candidate")"
  [ "$resolved" = "$self" ] && continue
  real="$candidate"; break
done
IFS="$old_ifs"
if [ -z "$real" ] && [ "$(uname -s)" = Darwin ]; then
  for candidate in "$HOME/Applications/Alacritty.app/Contents/MacOS/alacritty" /Applications/Alacritty.app/Contents/MacOS/alacritty; do
    if [ -x "$candidate" ]; then real="$candidate"; break; fi
  done
fi
if [ -z "$real" ]; then printf 'Alacritty executable not found; install Alacritty before using this terminal wrapper.\n' >&2; exit 127; fi
case "${1:-}" in msg|migrate|--version|-V|--help|-h) exec "$real" "$@" ;; esac
for arg in "$@"; do case "$arg" in -e|--command) exec "$real" "$@" ;; esac; done
tmux_bin="$(command -v tmux 2>/dev/null || true)"
if [ -z "$tmux_bin" ]; then printf 'tmux is required for ordinary Alacritty launches; install tmux or pass -e/--command.\n' >&2; exit 127; fi
exec "$real" "$@" -e "$tmux_bin" new-session -A -s main
