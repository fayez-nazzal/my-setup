#!/usr/bin/env bash
# Shadows the real /usr/bin/alacritty everywhere Alacritty gets launched.
#
# This lives at $HOME/.local/bin/alacritty, ahead of /usr/bin on $PATH
# for interactive shells and GNOME's xdg-terminal-exec launches. It keeps
# ordinary terminal launches in the persistent tmux session "main".
#
# Non-window subcommands pass straight through to the real binary. Explicit
# `-e`/`--command` launches also pass through so xdg-terminal-exec can run
# the command it requested instead of opening the persistent tmux session.
set -euo pipefail

REAL_ALACRITTY=/usr/bin/alacritty # adjust if installed elsewhere (Homebrew, etc.)

case "${1:-}" in
  msg | migrate | --version | -V | --help | -h)
    exec "$REAL_ALACRITTY" "$@"
    ;;
esac

for arg in "$@"; do
  case "$arg" in
    -e | --command)
      exec "$REAL_ALACRITTY" "$@"
      ;;
  esac
done



exec "$REAL_ALACRITTY" -e tmux new-session -A -s main
