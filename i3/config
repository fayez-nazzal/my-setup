# i3 config file (v4) — this machine's actual, in-use config (i3 4.24,
# Debian). Mirrors .aerospace.toml's Alt-based ergonomics (see keyd/ for the
# Mac-keyboard remap that makes this feel like AeroSpace on a Mac keyboard).
#
# Machine-specific values that need adjusting on a different box (documented,
# not hidden): the xrandr output names on line ~11, the wallpaper path, and
# the workspace `assign` rules' window classes (confirm with `xprop`).

# Font for window titles and the bar. Requires the GeistMono Nerd Font — see
# ../README.md for install instructions (not apt-packaged).
font pango:GeistMono Nerd Font Mono 9

# Start XDG autostart .desktop files (e.g. the 1Password autostart entry
# under ~/.config/autostart/) using dex.
exec --no-startup-id dex --autostart --environment i3

# Output layout for this machine: external monitor primary, laptop panel
# off. Adjust output names for your hardware (`xrandr --query`).
exec --no-startup-id xrandr --output HDMI-1 --mode 1920x1080 --rate 60 --primary --output LVDS-1 --off

# Compositor: eliminates tearing on scroll/hover/animations. Tuned for
# Intel HD Graphics 3000 in ../picom/picom.conf — retune for other GPUs.
exec --no-startup-id picom --config ~/.config/picom/picom.conf

# Desktop wallpaper.
exec --no-startup-id feh --bg-fill ~/.config/i3/wallpaper/nature.jpg

# xss-lock grabs a logind suspend inhibit lock and runs i3lock before
# suspend; also usable directly via `loginctl lock-session`.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# System tray applet for NetworkManager. No-op if network-manager-gnome
# isn't installed (this config has no systray `bar` block to dock it in
# either — install a tray if you want the icon to actually show).
exec --no-startup-id nm-applet

# Volume/mic keys via PulseAudio's pactl, refreshing i3status on change.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Rotated homerow layout, matching .aerospace.toml's alt-j/k/l/semicolon
# (not classic vim hjkl — intentional, kept identical to the Mac config).
set $up l
set $down k
set $left j
set $right semicolon

# Mouse+Mod1 drags floating windows; titlebar or Mod1+click drags tiled ones.
floating_modifier Mod1
tiling_drag modifier titlebar

# Focus.
bindsym Mod1+$left focus left
bindsym Mod1+$down focus down
bindsym Mod1+$up focus up
bindsym Mod1+$right focus right
bindsym Mod1+Left focus left
bindsym Mod1+Down focus down
bindsym Mod1+Up focus up
bindsym Mod1+Right focus right

# Move focused window.
bindsym Mod1+Shift+$left move left
bindsym Mod1+Shift+$down move down
bindsym Mod1+Shift+$up move up
bindsym Mod1+Shift+$right move right
bindsym Mod1+Shift+Left move left
bindsym Mod1+Shift+Down move down
bindsym Mod1+Shift+Up move up
bindsym Mod1+Shift+Right move right

bindsym Mod1+h split h
bindsym Mod1+v split v

# Fullscreen. Caps Lock is remapped to F13 by keyd, installed system-wide at
# /etc/keyd/{default,apple-magic-keyboard}.conf — see ../keyd/README.md for
# why it's two files and how to install them (requires sudo).
bindsym F13 fullscreen toggle

bindsym Mod1+s layout stacking
bindsym Mod1+w layout tabbed
bindsym Mod1+e layout toggle split

bindsym Mod1+Shift+space floating toggle
bindsym Mod1+space focus mode_toggle

bindsym Mod1+a focus parent

bindsym Mod1+Shift+minus move scratchpad
bindsym Mod1+minus scratchpad show

# Workspaces. Numbers get descriptive labels for the apps `assign`ed below;
# adjust both the labels and the assign rules for what's installed on your
# machine (confirm each app's WM_CLASS with `xprop`).
set $ws1 "1: Terminal"
set $ws2 "2: Browser"
set $ws3 "3: Zed Editor"
set $ws4 "4: Obsidian"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $wsP "P: 1Password"

assign [class="Alacritty"] $ws1
assign [class="Helium"] $ws2
assign [class="dev.zed.Zed"] $ws3
assign [class="obsidian"] $ws4
assign [class="com.onepassword.OnePassword"] $wsP
for_window [class="com.onepassword.OnePassword"] move to workspace $wsP

bindsym Mod1+1 workspace number $ws1
bindsym Mod1+2 workspace number $ws2
bindsym Mod1+3 workspace number $ws3
bindsym Mod1+4 workspace number $ws4
bindsym Mod1+5 workspace number $ws5
bindsym Mod1+6 workspace number $ws6
bindsym Mod1+7 workspace number $ws7
bindsym Mod1+8 workspace number $ws8
bindsym Mod1+9 workspace number $ws9
bindsym Mod1+0 workspace number $ws10
bindsym Mod1+p workspace $wsP

bindsym Mod1+Shift+1 move container to workspace number $ws1
bindsym Mod1+Shift+2 move container to workspace number $ws2
bindsym Mod1+Shift+3 move container to workspace number $ws3
bindsym Mod1+Shift+4 move container to workspace number $ws4
bindsym Mod1+Shift+5 move container to workspace number $ws5
bindsym Mod1+Shift+6 move container to workspace number $ws6
bindsym Mod1+Shift+7 move container to workspace number $ws7
bindsym Mod1+Shift+8 move container to workspace number $ws8
bindsym Mod1+Shift+9 move container to workspace number $ws9
bindsym Mod1+Shift+0 move container to workspace number $ws10
bindsym Mod1+Shift+p move container to workspace $wsP

bindsym Mod1+Shift+c reload
bindsym Mod1+Shift+r restart
bindsym Mod1+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

mode "resize" {
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym Mod1+r mode "default"
}
bindsym Mod1+r mode "resize"

# i3bar, driven by ../i3status/status.py (a custom Python status script, not
# stock i3status — see ../README.md for why and its runtime requirements).
bar {
        status_command python3 ~/.config/i3status/status.py
        font pango:GeistMono Nerd Font Mono SemiBold 10
        position top
        separator_symbol " │ "
        colors {
                background #1b1f27
                statusline #eceff4
                separator  #5c6470
        }
}

set $mod Mod1
bindsym $mod+q kill
bindsym $mod+Return exec --no-startup-id ~/.local/bin/alacritty
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym Mod4+space exec --no-startup-id rofi -show drun
bindsym $mod+b exec --no-startup-id helium
bindsym $mod+Shift+x exec i3lock -c 202020

# App launch shortcuts — replace with whatever you actually have installed.
bindsym $mod+z exec --no-startup-id zed
bindsym $mod+o exec --no-startup-id obsidian

# Gaps, matching .aerospace.toml's spirit (i3 4.22+ native gaps, no i3-gaps
# fork needed — merged upstream, ships in Debian 12+).
gaps inner 10
gaps outer 2
smart_gaps on
smart_borders on
