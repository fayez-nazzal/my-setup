{
  "mcpServers": {
    "pencil": {
      "type": "stdio",
      "command": "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
      "args": ["--app", "desktop"],
      "env": {}
    },
    "clipbolt": {
      "type": "http",
      "url": "http://localhost:3002/api/mcp"
    },
    "excalidraw": {
      "type": "http",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "!key=$(op read \"op://OMP/OMP EXCALIDRAW/password\" --no-newline) && printf 'Bearer %s' \"$key\""
      }
    }
  }
}
